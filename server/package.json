{
  "name": "aurora-photography-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API, Postgres database and authentication for Aurora Photography",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
