# Copy this file to .env and fill in the values. .env is ignored by git, so your secrets stay on your machine.
# On Railway, set the same names under your service's "Variables" tab instead.

# Your Neon connection strings. `neon env pull` (or `neon deploy`) fills these in for you.
# DATABASE_URL is the pooled one (-pooler) the app uses; DATABASE_URL_UNPOOLED is the direct one
# that npm run db:migrate and db:seed use. Keep ?sslmode=require on the end.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# A long random string Better Auth uses to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The address people open the site at. In development that's the Vite dev server,
# because Vite forwards /api to this server. In production it's your Vercel URL.
BETTER_AUTH_URL=http://localhost:5173

# Frontend addresses allowed to call the API with cookies (comma-separated).
CLIENT_ORIGINS=http://localhost:5173

# Railway sets PORT for you. Locally the API runs on 3000.
PORT=3000
