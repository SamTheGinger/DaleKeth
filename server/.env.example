# Copy to .env for local development. In production, set these in the Vercel project's Environment Variables.

# --- Required ---------------------------------------------------------------

# Neon Postgres. `neon env pull` fills both in.
# DATABASE_URL (pooled) is used by the app; DATABASE_URL_UNPOOLED (direct) by migrate/seed scripts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public URL of the site (the Vite dev server locally; it proxies /api to this server).
BETTER_AUTH_URL=http://localhost:5173

# Comma-separated origins allowed to make credentialed requests. Defaults to BETTER_AUTH_URL.
CLIENT_ORIGINS=http://localhost:5173

PORT=3000

# --- Optional: email (Resend) -----------------------------------------------
# Without RESEND_API_KEY, emails are skipped with a log warning.

RESEND_API_KEY=
EMAIL_FROM=Aurora Photography <onboarding@resend.dev>
MARKETING_NOTIFY_EMAIL=sam@bluvibe.co.za
# Created by `npm run subscribers:sync` on first run.
RESEND_SEGMENT_ID=
# Resend → Webhooks → signing secret (for /api/webhooks/resend).
RESEND_WEBHOOK_SECRET=

# --- Optional: payments (Stripe, test mode) ---------------------------------
# Without STRIPE_SECRET_KEY, checkout responds 503.

STRIPE_SECRET_KEY=
# Locally: printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=
